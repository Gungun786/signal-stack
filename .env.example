# Signal Stack Environment Variables

# Primary LLM: Google AI Studio Gemini API Free Tier (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM: Groq Cloud API Free Tier (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Database URL (SQLite locally, PostgreSQL on Supabase/Neon in production)
DATABASE_URL=sqlite:///./signal_stack.db
# Example for Supabase/Neon:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Automation & Webhook Security
CRON_SECRET=signal_stack_secure_cron_token_2026

# Server configuration
PORT=8000
ENV=development
